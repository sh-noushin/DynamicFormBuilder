<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2c1551f8-4f7e-4260-af2b-d80e214de357</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="15.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.15" />
    <!--
      Microsoft.OpenApi 2.0.0 (pulled transitively via Scalar.AspNetCore) is flagged by
      GHSA-v5pm-xwqc-g5wc. The advisory affects the entire 2.x line; the fix is in 3.x,
      but Microsoft.OpenApi 3.x made IOpenApiMediaType.Example read-only which breaks
      Microsoft.AspNetCore.OpenApi 10.0.x's XmlCommentGenerator source generator.

      The vulnerability is about parsing untrusted OpenAPI documents; this project only
      GENERATES an OpenAPI document from its own source and exposes it under
      Development environment only (see Program.cs UseOpenApi guard). Not reachable
      here. Suppressed until Microsoft.AspNetCore.OpenApi updates to a version built
      against Microsoft.OpenApi 3.x.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormBuilder.Core\FormBuilder.Core.csproj" />
    <ProjectReference Include="..\FormBuilder.Infrastructure\FormBuilder.Infrastructure.csproj" />
    <ProjectReference Include="..\FormBuilder.Models\FormBuilder.Models.csproj" />
  </ItemGroup>

</Project>
