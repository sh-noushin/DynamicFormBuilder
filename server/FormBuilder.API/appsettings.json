{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=FormBuilder.db"
  },
  "Jwt": {
    "Issuer": "FormBuilderAPI",
    "Audience": "FormBuilderApp",
    "ExpireMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileUploads": {
    "StoragePath": "uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
