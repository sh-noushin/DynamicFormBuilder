{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=FormBuilder.db"
  },
  "Jwt": {
    "Issuer": "FormBuilderAPI",
    "Audience": "FormBuilderApp",
    "ExpireMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileUploads": {
    "StoragePath": "uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": []
  },
  "Notifications": {
    "AdminEmail": "",
    "FromAddress": "no-reply@formbuilder.local",
    "FromDisplayName": "FormBuilder",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseSsl": true,
    "SmtpUsername": "",
    "SmtpPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
